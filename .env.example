# ==============================================================================
# GridWise LLM Energy Optimization Backend - Environment Configuration Template
# ==============================================================================

# LLM Provider: 'openai' (default), 'gemini', 'ollama', or 'mock' (strictly unit tests only)
LLM_PROVIDER=openai

# Model identifier
# Examples:
# OpenAI: gpt-4o-mini
# Gemini: gemini-2.0-flash
# Groq: llama-3.3-70b-versatile
# Ollama: llama3
LLM_MODEL=gpt-4o-mini

# Model API Key (Never commit real keys!)
LLM_API_KEY=your_api_key_here

# Custom Base URL (Optional - leave empty for default OpenAI/Gemini endpoints)
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama: http://localhost:11434
LLM_BASE_URL=

# Timeout and Retry configuration
LLM_TIMEOUT_SEC=15.0
LLM_MAX_RETRIES=2

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Cache configuration
CACHE_SIZE=256
CACHE_TTL_SEC=1800
